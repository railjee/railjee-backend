NODE_ENV=development
APP_PORT=3000
APP_NAME=railji-backend

# Database
MONGODB_URI=mongodb://localhost:27017/railji

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=7d

# Logging
LOG_LEVEL=debug
LOG_MAX_FILES=14

# Meta Conversions API (see docs/plans/2026-10-30-meta-conversions-api.md)
# Without META_PIXEL_ID and META_CAPI_ACCESS_TOKEN, events are skipped (logged as "skipped").
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Set only while testing in Events Manager > Test events; remove for live traffic.
META_TEST_EVENT_CODE=
META_GRAPH_API_VERSION=v26.0
META_CAPI_TIMEOUT_MS=3000
SITE_URL=https://railjee.in
# Shared with the Next.js server (Netlify) so it can forward the visitor's IP and user agent.
INTERNAL_FORWARD_SECRET=
# Comma list of test accounts; an entry starting with "@" matches the whole domain.
INTERNAL_EMAILS=
